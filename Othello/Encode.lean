import Othello.Reference

/-!
# Boards as pairs of bit sets, and a search with an oracle

`decodeBoard n bl wh` is the board whose black / white discs are the bits of
the natural numbers `bl` / `wh` (square `(x, y)` is bit `8 * y + x`), and
`encode` goes back.  Unlike the bitboards of `Othello/Bitboard.lean`, nothing
clever is done with these numbers: moves are generated by the functions of the
specification, applied to the decoded board.  This works for boards up to
8 × 8.

`refSearch` is a game-tree search on such positions which may, in addition,
accept a position because an *oracle* says so.  `refSearch_sound`: if the
oracle is right, a successful search is a strategy.  It is used for 8 × 8
Othello, where the oracle is a table of positions taken from the literature.
-/

namespace Othello

variable {n : Nat}

/-! ## Encoding -/

/-- The bit number of a square. -/
def bitIdx (s : Square) : Nat := (8 * s.2 + s.1).toNat

/-- The board with black discs on the bits of `bl` and white discs on the
bits of `wh`. -/
def decodeBoard (n : Nat) (bl wh : Nat) : Board := fun s =>
  if OnBoard n s then
    if bl.testBit (bitIdx s) then some .black
    else if wh.testBit (bitIdx s) then some .white
    else none
  else none

/-- The set of squares on which `b` has a disc of colour `c`, as a bit set. -/
def encode (n : Nat) (b : Board) (c : Color) : Nat :=
  (squares n).foldl (fun acc s => if b s = some c then acc ||| 2 ^ bitIdx s else acc) 0

theorem clean_decodeBoard (bl wh : Nat) : Clean n (decodeBoard n bl wh) := by
  intro s hs
  simp [decodeBoard, hs]

theorem bitIdx_inj (hn : n ≤ 8) {s t : Square} (hs : OnBoard n s) (ht : OnBoard n t)
    (h : bitIdx s = bitIdx t) : s = t := by
  unfold OnBoard at hs ht
  unfold bitIdx at h
  apply Prod.ext <;> omega

theorem testBit_foldl (b : Board) (c : Color) (i : Nat) :
    ∀ (l : List Square) (acc : Nat),
      (l.foldl (fun acc s => if b s = some c then acc ||| 2 ^ bitIdx s else acc) acc).testBit i
        = (acc.testBit i || l.any fun s => decide (bitIdx s = i) && decide (b s = some c)) := by
  intro l
  induction l with
  | nil => intro acc; simp
  | cons s l ih =>
    intro acc
    rw [List.foldl_cons, ih, List.any_cons]
    by_cases h : b s = some c
    · simp only [h, ↓reduceIte, Nat.testBit_or, Nat.testBit_two_pow, decide_true, Bool.and_true,
        Bool.or_assoc]
    · simp [h]

theorem testBit_encode (hn : n ≤ 8) (b : Board) (c : Color) {s : Square} (hs : OnBoard n s) :
    (encode n b c).testBit (bitIdx s) = decide (b s = some c) := by
  unfold encode
  rw [testBit_foldl, Nat.zero_testBit, Bool.false_or]
  by_cases h : b s = some c
  · rw [decide_eq_true h, List.any_eq_true]
    exact ⟨s, mem_squares.2 hs, by simp [h]⟩
  · rw [decide_eq_false h]
    apply Bool.eq_false_iff.2
    intro hany
    rw [List.any_eq_true] at hany
    obtain ⟨q, hq, hq'⟩ := hany
    simp only [Bool.and_eq_true, decide_eq_true_eq] at hq'
    have := bitIdx_inj hn (mem_squares.1 hq) hs hq'.1
    rw [this] at hq'
    exact h hq'.2

/-- Encoding a board and decoding it again gives the same board. -/
theorem decode_encode (hn : n ≤ 8) {b : Board} (hb : Clean n b) :
    decodeBoard n (encode n b .black) (encode n b .white) = b := by
  funext s
  unfold decodeBoard
  by_cases hs : OnBoard n s
  · simp only [hs, ↓reduceIte, testBit_encode hn b _ hs, decide_eq_true_eq]
    cases hbs : b s with
    | none => simp
    | some c => cases c <;> simp
  · simp [hs, hb s hs]

/-- The bit set of the discs of colour `c'` after `c` has played on `s`.
(Same as `encode n (play n b c s) c'`, but the flipped discs are computed
only once.) -/
def encodePlay (n : Nat) (b : Board) (c : Color) (s : Square) (c' : Color) : Nat :=
  let fl := flips n b c s
  (squares n).foldl
    (fun acc q =>
      if (if q = s ∨ q ∈ fl then some c else b q) = some c' then acc ||| 2 ^ bitIdx q else acc) 0

theorem encodePlay_eq (b : Board) (c : Color) (s : Square) (c' : Color) :
    encodePlay n b c s c' = encode n (play n b c s) c' := rfl

/-! ## Search with hints and an oracle -/

/-- Hints for `refSearch`: moves to try first, each with hints for the
position after the move. -/
inductive RHint where
  | node (children : List (Square × RHint))

namespace RHint

/-- No hints. -/
def none : RHint := .node []

def children : RHint → List (Square × RHint)
  | .node l => l

/-- The hints for the position after the move `s`. -/
def sub (h : RHint) (s : Square) : RHint := (h.children.lookup s).getD .none

end RHint

/-- `refSearch n oracle p t fuel h bl wh c = true` only if, on the board
`decodeBoard n bl wh` with `c` to move, player `p` can secure a margin of at
least `t` — provided the positions accepted by `oracle` have this property. -/
def refSearch (n : Nat) (oracle : Color → Nat → Nat → Color → Bool) (p : Color) (t : Int) :
    Nat → RHint → Nat → Nat → Color → Bool
  | 0, _, _, _, _ => false
  | fuel + 1, h, bl, wh, c =>
    if oracle p bl wh c then true
    else
      let b := decodeBoard n bl wh
      match moves n b c with
      | [] =>
        if moves n b c.opponent = [] then decide (t ≤ margin n b p)
        else refSearch n oracle p t fuel h bl wh c.opponent
      | s :: ss =>
        if c = p then
          (h.children.any fun x =>
            decide (x.1 ∈ s :: ss) &&
              refSearch n oracle p t fuel x.2
                (encodePlay n b c x.1 .black) (encodePlay n b c x.1 .white) c.opponent) ||
          ((s :: ss).any fun q =>
            refSearch n oracle p t fuel .none
              (encodePlay n b c q .black) (encodePlay n b c q .white) c.opponent)
        else
          (s :: ss).all fun q =>
            refSearch n oracle p t fuel (h.sub q)
              (encodePlay n b c q .black) (encodePlay n b c q .white) c.opponent

/-- If the oracle only accepts positions in which `p` can secure `t`, a
successful search is a strategy. -/
theorem refSearch_sound (hn : n ≤ 8) {oracle : Color → Nat → Nat → Color → Bool}
    {p : Color} {t : Int}
    (horacle : ∀ bl wh c, oracle p bl wh c = true → Secures n p t (decodeBoard n bl wh) c) :
    ∀ (fuel : Nat) (h : RHint) (bl wh : Nat) (c : Color),
      refSearch n oracle p t fuel h bl wh c = true → Secures n p t (decodeBoard n bl wh) c := by
  intro fuel
  induction fuel with
  | zero =>
    intro h bl wh c hs
    simp [refSearch] at hs
  | succ fuel ih =>
    intro h bl wh c hs
    simp only [refSearch] at hs
    split at hs
    · rename_i ho
      exact horacle bl wh c ho
    · have key : ∀ q, q ∈ moves n (decodeBoard n bl wh) c →
          decodeBoard n (encodePlay n (decodeBoard n bl wh) c q .black)
            (encodePlay n (decodeBoard n bl wh) c q .white)
            = play n (decodeBoard n bl wh) c q := by
        intro q hq
        rw [encodePlay_eq, encodePlay_eq]
        exact decode_encode hn (clean_play (clean_decodeBoard bl wh) (mem_moves.1 hq).1)
      split at hs
      · rename_i hm
        split at hs
        · rename_i hop
          exact .over hm hop (of_decide_eq_true hs)
        · rename_i hop
          exact .pass hm hop (ih h bl wh c.opponent hs)
      · rename_i s ss hm
        have hne : moves n (decodeBoard n bl wh) c ≠ [] := by
          rw [hm]; exact List.cons_ne_nil _ _
        split at hs
        · rename_i hc
          rw [Bool.or_eq_true, List.any_eq_true, List.any_eq_true] at hs
          rcases hs with ⟨x, _, hx⟩ | ⟨q, hq, hx⟩
          · rw [Bool.and_eq_true, decide_eq_true_eq] at hx
            have hq : x.1 ∈ moves n (decodeBoard n bl wh) c := by rw [hm]; exact hx.1
            have h1 := ih _ _ _ _ hx.2
            rw [key x.1 hq] at h1
            exact .choose x.1 hc hq h1
          · have hq' : q ∈ moves n (decodeBoard n bl wh) c := by rw [hm]; exact hq
            have h1 := ih _ _ _ _ hx
            rw [key q hq'] at h1
            exact .choose q hc hq' h1
        · rename_i hc
          rw [List.all_eq_true] at hs
          refine .reply hc hne ?_
          intro q hq
          have h1 := ih _ _ _ _ (hs q (by rw [← hm]; exact hq))
          rw [key q hq] at h1
          exact h1

/-! ## Reading hints -/

/-- Parse the children of a hint node (same format as in
`Othello/HintParse.lean`: a move is the character with code `48 + 8 * y + x`). -/
def parseRChildren : Nat → List Char → List (Square × RHint) × List Char
  | 0, cs => ([], cs)
  | _ + 1, [] => ([], [])
  | fuel + 1, c :: cs =>
    if c = ')' then ([], cs)
    else
      let i : Nat := c.toNat - 48
      let s : Square := (((i % 8 : Nat) : Int), ((i / 8 : Nat) : Int))
      match cs with
      | '(' :: cs' =>
        let (sub, rest) := parseRChildren fuel cs'
        let (sibs, rest') := parseRChildren fuel rest
        ((s, RHint.node sub) :: sibs, rest')
      | _ =>
        let (sibs, rest') := parseRChildren fuel cs
        ((s, RHint.none) :: sibs, rest')

/-- Parse a hint string. -/
def parseRHint (str : String) : RHint :=
  match str.toList with
  | '(' :: cs => RHint.node (parseRChildren str.length cs).1
  | _ => RHint.none

end Othello
